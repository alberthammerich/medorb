{
  "name": "medorb",
  "version": "0.1.0",
  "description": "A motion system for clinical AI work.",
  "author": "Albert Hammerich",
  "homepage": "https://alberthammerich.github.io/medorb/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alberthammerich/medorb.git"
  },
  "bugs": {
    "url": "https://github.com/alberthammerich/medorb/issues"
  },
  "type": "module",
  "main": "./dist/lib/medorb.js",
  "module": "./dist/lib/medorb.js",
  "types": "./dist/lib/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/medorb.js"
    },
    "./styles.css": "./dist/lib/medorb.css"
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.lib.config.ts",
    "build:pages": "vite build --base=/medorb/",
    "check": "npm test && npm pack --dry-run --cache .npm-cache",
    "test": "npm run build && node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "keywords": [
    "react",
    "medical",
    "healthcare",
    "ai",
    "status",
    "animation",
    "design-system"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.10.1"
}
